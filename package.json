{
  "name": "@gum-jsx/core",
  "version": "1.9.0",
  "description": "Language for vector graphics generation.",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-core.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/gum.d.ts",
      "import": "./src/gum.ts"
    },
    "./env": {
      "types": "./types/env.d.ts",
      "import": "./src/env.ts"
    },
    "./eval": {
      "types": "./types/eval.d.ts",
      "import": "./src/eval.ts"
    },
    "./inspect": {
      "types": "./types/inspect.d.ts",
      "import": "./src/inspect.ts"
    },
    "./fonts": {
      "types": "./types/fonts/fonts.d.ts",
      "import": "./src/fonts/fonts.ts"
    },
    "./fonts/*": "./src/fonts/*",
    "./lib/*": {
      "types": "./types/lib/*.d.ts",
      "import": "./src/lib/*.ts"
    },
    "./elems/*": {
      "types": "./types/elems/*.d.ts",
      "import": "./src/elems/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "bun tsc --noEmit",
    "types": "rm -rf types && bun tsc -p tsconfig.types.json && cp -r src/types types/types",
    "prepublishOnly": "bun run types"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2",
    "emojibase-regex": "^17.0.0",
    "linebreak": "^1.1.0",
    "opentype.js": "^1.3.4",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/papaparse": "^5.5.2",
    "typescript": "^5.9.3"
  }
}
